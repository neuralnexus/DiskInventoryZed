<Window x:Class="DiskInventoryZed.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:DiskInventoryZed.Windows.Controls"
        xmlns:models="clr-namespace:DiskInventoryZed.Core.Models;assembly=DiskInventoryZed.Core"
        mc:Ignorable="d"
        Title="Disk Inventory Zed"
        Icon="Assets/AppIcon.ico"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="FlatButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,3" />
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:FileNode}" ItemsSource="{Binding DirectoryChildren}">
            <Grid Margin="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Converter={StaticResource NodeGlyph}}"
                           Foreground="{Binding Converter={StaticResource FileTypeBrush}}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Margin="3,0,8,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Foreground="{StaticResource SecondaryText}" FontSize="10" />
            </Grid>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="66" />
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Product header -->
        <Border Grid.Row="0" Background="#10161E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="4" />
                    <Ellipse Width="22" Height="22" Stroke="#478FD4" StrokeThickness="4" />
                    <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="DISK INVENTORY ZED" FontSize="17" FontWeight="Bold" />
                    <TextBlock Text="Windows storage map  •  local, mapped, and UNC locations"
                               Foreground="{StaticResource SecondaryText}" FontSize="11" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Export JSON" Click="ExportJson_Click" Margin="0,0,7,0" IsEnabled="{Binding CanUseSnapshot}" />
                    <Button Content="Export CSV" Click="ExportCsv_Click" Margin="0,0,7,0" IsEnabled="{Binding CanUseSnapshot}" />
                    <Button Content="Rescan" Click="Rescan_Click" IsEnabled="{Binding CanRescan}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation and filters -->
        <Border Grid.Row="1" Background="#0E141B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="12,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="235" />
                    <ColumnDefinition Width="125" />
                    <ColumnDefinition Width="145" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="←" ToolTip="Back (Alt+Left)" Click="Back_Click" IsEnabled="{Binding CanNavigateBack}" />
                    <Button Style="{StaticResource IconButton}" Content="→" ToolTip="Forward (Alt+Right)" Click="Forward_Click" IsEnabled="{Binding CanNavigateForward}" Margin="4,0,0,0" />
                    <Button Style="{StaticResource IconButton}" Content="↑" ToolTip="Up (Backspace)" Click="Up_Click" IsEnabled="{Binding CanUseSnapshot}" Margin="4,0,0,0" />
                    <Button Style="{StaticResource IconButton}" Content="⌂" ToolTip="Scan root" Click="Root_Click" IsEnabled="{Binding CanUseSnapshot}" Margin="4,0,8,0" />
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,10,0"
                              IsEnabled="{Binding CanUseSnapshot}">
                    <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="›" Foreground="{StaticResource SecondaryText}" VerticalAlignment="Center" Margin="3,0" />
                                    <Button Style="{StaticResource FlatButton}" Content="{Binding DisplayName}" Click="Breadcrumb_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBox Grid.Column="2" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search files and paths"
                         ToolTip="Search names and full paths across this scan" Margin="0,0,8,0" IsEnabled="{Binding CanUseSnapshot}" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding MinimumSizeOptions}" DisplayMemberPath="Label"
                          AutomationProperties.Name="Minimum file size"
                          SelectedValuePath="Value" SelectedValue="{Binding MinimumSize}" Margin="0,0,8,0" IsEnabled="{Binding CanUseSnapshot}" />
                <ComboBox Grid.Column="4" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label"
                          AutomationProperties.Name="File sort order"
                          SelectedValuePath="Value" SelectedValue="{Binding SortOrder}" IsEnabled="{Binding CanUseSnapshot}" />
            </Grid>
        </Border>

        <!-- Three-pane workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="255" MinWidth="210" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="330" MinWidth="285" />
            </Grid.ColumnDefinitions>

            <!-- Locations and folder tree -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="SCAN A LOCATION" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox" Text="{Binding PathText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Folder, drive, or UNC path"
                                     ToolTip="Examples: C:\, Z:\, or \\server\share" KeyDown="PathBox_KeyDown"
                                     IsEnabled="{Binding CanStartScan}" />
                            <Button Grid.Column="1" Content="Scan" Style="{StaticResource AccentButton}" Click="ScanPath_Click" Margin="6,0,0,0"
                                    IsEnabled="{Binding CanStartScan}" />
                        </Grid>
                        <Button Content="Choose folder..." Click="ChooseFolder_Click" Margin="0,7,0,0" HorizontalContentAlignment="Center"
                                IsEnabled="{Binding CanStartScan}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="370" Margin="0,14,0,10"
                                  IsEnabled="{Binding CanStartScan}">
                        <StackPanel>
                            <TextBlock Text="SCAN OPTIONS" Style="{StaticResource SectionLabel}" Margin="0,0,0,3" />
                            <CheckBox Content="Show hidden items" IsChecked="{Binding ShowHiddenFiles}" />
                            <CheckBox Content="Skip developer output" IsChecked="{Binding SkipDeveloperFolders}" />
                            <CheckBox Content="Follow links and junctions" IsChecked="{Binding FollowReparsePoints}"
                                      ToolTip="Off is safest. When enabled, file IDs still prevent directory cycles." />

                            <TextBlock Text="QUICK LOCATIONS" Style="{StaticResource SectionLabel}" Margin="0,13,0,4" />
                            <ItemsControl ItemsSource="{Binding QuickLocations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="Location_Click" Margin="0,2" Padding="8,6" HorizontalContentAlignment="Left"
                                                IsEnabled="{Binding DataContext.CanStartScan, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryText}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="DRIVES" Style="{StaticResource SectionLabel}" Margin="0,13,0,4" />
                            <ItemsControl ItemsSource="{Binding Drives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Click="Location_Click" Margin="0,2" Padding="8,6" HorizontalContentAlignment="Left"
                                                IsEnabled="{Binding DataContext.CanStartScan, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding DriveBadge}" Foreground="{StaticResource AccentBrush}" FontSize="8" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource SecondaryText}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="SCANNED TREE" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" />
                        <TreeView Grid.Row="1" ItemsSource="{Binding RootFolders}" SelectedItemChanged="FolderTree_SelectedItemChanged"
                                  IsEnabled="{Binding CanUseSnapshot}" AutomationProperties.Name="Scanned folder tree" />
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#202A35" />

            <!-- Visualization workspace. Sunburst is deliberately first/default. -->
            <Grid Grid.Column="2" Background="#0A0E13">
                <TabControl x:Name="VisualizationTabs" SelectedIndex="0" Margin="7" IsEnabled="{Binding CanUseSnapshot}">
                    <TabItem Header="SUNBURST  Ctrl+1"
                             AutomationProperties.HelpText="Visual overview. Use the List tab for keyboard and screen-reader access to scanned items.">
                        <controls:SunburstControl Node="{Binding CurrentNode}"
                                                  AutomationProperties.Name="Interactive disk usage sunburst"
                                                  Focusable="False"
                                                  MinimumSize="{Binding MinimumSize}"
                                                  SearchText="{Binding SearchText}"
                                                  SelectedExtension="{Binding SelectedExtension}"
                                                  NodeSelected="Visualization_NodeSelected"
                                                  NodeInvoked="Visualization_NodeInvoked">
                            <controls:SunburstControl.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Click="OpenSelected_Click" />
                                    <MenuItem Header="Show in File Explorer" Click="RevealSelected_Click" />
                                    <MenuItem Header="Open containing folder" Click="OpenContaining_Click" />
                                </ContextMenu>
                            </controls:SunburstControl.ContextMenu>
                        </controls:SunburstControl>
                    </TabItem>
                    <TabItem Header="HEATMAP  Ctrl+2"
                             AutomationProperties.HelpText="Visual overview. Use the List tab for keyboard and screen-reader access to scanned items.">
                        <controls:TreemapControl Node="{Binding CurrentNode}"
                                                 AutomationProperties.Name="Interactive disk usage heatmap"
                                                 Focusable="False"
                                                 MinimumSize="{Binding MinimumSize}"
                                                 SearchText="{Binding SearchText}"
                                                 SelectedExtension="{Binding SelectedExtension}"
                                                 NodeSelected="Visualization_NodeSelected"
                                                 NodeInvoked="Visualization_NodeInvoked">
                            <controls:TreemapControl.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Click="OpenSelected_Click" />
                                    <MenuItem Header="Show in File Explorer" Click="RevealSelected_Click" />
                                    <MenuItem Header="Open containing folder" Click="OpenContaining_Click" />
                                </ContextMenu>
                            </controls:TreemapControl.ContextMenu>
                        </controls:TreemapControl>
                    </TabItem>
                    <TabItem Header="LIST  Ctrl+3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding VisibleItemsStatus}" Foreground="{StaticResource SecondaryText}"
                                       FontSize="10" Margin="8,4" AutomationProperties.LiveSetting="Polite" />
                        <DataGrid x:Name="FileGrid" Grid.Row="1"
                                  AutomationProperties.Name="Scanned files and folders"
                                  AutomationProperties.HelpText="Press Enter to open the selected item. Press Shift+F10 for item actions."
                                  ItemsSource="{Binding VisibleItems}"
                                  SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  Background="#0A0E13"
                                  Foreground="{StaticResource PrimaryText}"
                                  BorderThickness="0"
                                  HorizontalGridLinesBrush="#1E2934"
                                  MouseDoubleClick="FileGrid_MouseDoubleClick"
                                  PreviewKeyDown="FileGrid_PreviewKeyDown"
                                  PreviewMouseRightButtonDown="FileGrid_PreviewMouseRightButtonDown"
                                  ContextMenuOpening="FileGrid_ContextMenuOpening">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Height" Value="34" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#254442" /></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1C2631" /></Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#151C25" />
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryText}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                    <Setter Property="Padding" Value="8,6" />
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="32">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource NodeGlyph}}" Foreground="{Binding Converter={StaticResource FileTypeBrush}}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Name" Binding="{Binding DisplayName}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="95" />
                                <DataGridTextColumn Header="On disk" Binding="{Binding FormattedSize}" Width="110" />
                                <DataGridTextColumn Header="Modified" Binding="{Binding ModificationDate, StringFormat={}{0:g}}" Width="145" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open" Click="OpenSelected_Click" />
                                    <MenuItem Header="Show in File Explorer" Click="RevealSelected_Click" />
                                    <MenuItem Header="Open containing folder" Click="OpenContaining_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Border Panel.ZIndex="10" Visibility="{Binding HasScan, Converter={StaticResource InverseBoolToVisibility}}"
                        Background="#0A0E13" Margin="7">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <Grid Width="150" Height="150" Margin="0,0,0,22">
                            <Ellipse Stroke="#23475A" StrokeThickness="22" />
                            <Ellipse Stroke="#3C9F91" StrokeThickness="15" Width="100" Height="100" />
                            <Ellipse Fill="#15232B" Width="54" Height="54" />
                        </Grid>
                        <TextBlock Text="See where the space went" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Start with a drive, folder, mapped drive letter, or a UNC share. The circular map opens first; switch to Heatmap for the rectangular view."
                                   Foreground="{StaticResource SecondaryText}" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,9,0,18" />
                        <Button Content="Choose a folder" Style="{StaticResource AccentButton}" Click="ChooseFolder_Click" HorizontalAlignment="Center" Padding="22,10"
                                IsEnabled="{Binding CanStartScan}" />
                    </StackPanel>
                </Border>

                <Border Panel.ZIndex="20" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"
                        Background="#F20A0E13" Margin="7">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="620">
                        <ProgressBar IsIndeterminate="True" Height="5" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="SCANNING" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,8" />
                        <TextBlock Text="{Binding ScanProgressText}" FontSize="13" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ScanStatusPath}" Foreground="{StaticResource SecondaryText}" FontFamily="Consolas"
                                   FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,7,0,18" Width="600" />
                        <Button Content="Cancel scan" Click="CancelScan_Click" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#202A35" />

            <!-- Analysis and inspector -->
            <Border Grid.Column="4" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="#18212A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11"
                            Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="SCAN SUMMARY" Style="{StaticResource SectionLabel}" />
                            <Grid Margin="0,9,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding SummarySize}" Style="{StaticResource MetricValue}" /><TextBlock Text="ON DISK" Style="{StaticResource SectionLabel}" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding SummaryFileCount}" Style="{StaticResource MetricValue}" /><TextBlock Text="FILES" Style="{StaticResource SectionLabel}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="{Binding SummaryDirectoryCount}" Style="{StaticResource MetricValue}" /><TextBlock Text="FOLDERS" Style="{StaticResource SectionLabel}" /></StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding DiagnosticsSummary}" Foreground="{StaticResource WarningBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,9,0,0"
                                       ToolTip="{Binding DiagnosticsDetail}" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding DiagnosticsDetail}" Foreground="{StaticResource SecondaryText}" FontSize="8"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="46" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <TabControl Grid.Row="1" Margin="0,10,0,8" Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}"
                                IsEnabled="{Binding CanUseSnapshot}">
                        <TabItem Header="TYPES">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Button Content="Clear type filter" Style="{StaticResource FlatButton}" HorizontalAlignment="Right" Click="ClearTypeFilter_Click" />
                                <ListBox x:Name="ExtensionList" Grid.Row="1" ItemsSource="{Binding ExtensionStats}" SelectionChanged="ExtensionList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="1">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Border Width="11" Height="11" CornerRadius="2" Background="{Binding Converter={StaticResource FileTypeBrush}}" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding FileCount, StringFormat={}{0:N0} files}" Foreground="{StaticResource SecondaryText}" FontSize="9" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="LARGEST">
                            <ListBox x:Name="LargestList" ItemsSource="{Binding LargestFiles}" MouseDoubleClick="InsightList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border Width="9" Height="9" Background="{Binding Converter={StaticResource FileTypeBrush}}" CornerRadius="2" />
                                            <StackPanel Grid.Column="1" Margin="5,0,8,0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource SecondaryText}" FontSize="8" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="REVIEW">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="OLD LARGE FILES" Style="{StaticResource SectionLabel}" Margin="5" />
                                    <ListBox x:Name="OldFilesList" ItemsSource="{Binding OldLargeFiles}" MaxHeight="180" MouseDoubleClick="InsightList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel><TextBlock Text="{Binding FormattedSize}" DockPanel.Dock="Right" FontSize="9" /><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontSize="10" /></DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Separator Background="{StaticResource BorderBrush}" Margin="3,8" />
                                    <TextBlock Text="POSSIBLE DUPLICATES" Style="{StaticResource SectionLabel}" Margin="5" />
                                    <TextBlock Text="Same-size candidates are sampled, then fully SHA-256 verified." Foreground="{StaticResource SecondaryText}" FontSize="9" TextWrapping="Wrap" Margin="5,0,5,7" />
                                    <ListBox ItemsSource="{Binding DuplicateCandidates}" MaxHeight="180">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="10" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource SecondaryText}" FontSize="9" /></StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <StackPanel Orientation="Horizontal" Margin="5,7">
                                        <Button Content="Verify contents" Click="VerifyDuplicates_Click" IsEnabled="{Binding CanVerifyDuplicates}" />
                                        <Button Content="Cancel" Click="CancelVerification_Click" Margin="6,0,0,0" Visibility="{Binding IsVerifying, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding VerificationStatus}" Foreground="{StaticResource SecondaryText}" FontSize="9" TextWrapping="Wrap" Margin="5" />
                                    <ListBox ItemsSource="{Binding VerifiedDuplicates}" MaxHeight="180">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel><TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource SecondaryText}" FontSize="9" /></StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <Border Grid.Row="2" Background="#0E141B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11"
                            Visibility="{Binding HasScan, Converter={StaticResource BoolToVisibility}}" IsEnabled="{Binding CanUseSnapshot}">
                        <StackPanel DataContext="{Binding InspectedNode}">
                            <TextBlock Text="SELECTION" Style="{StaticResource SectionLabel}" />
                            <DockPanel Margin="0,8,0,5">
                                <Border Width="13" Height="13" Background="{Binding Converter={StaticResource FileTypeBrush}}" CornerRadius="2" Margin="0,1,7,0" />
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="On disk" Foreground="{StaticResource SecondaryText}" FontSize="10" />
                                <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Text="Logical" Foreground="{StaticResource SecondaryText}" FontSize="10" Margin="0,3,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormattedLogicalSize}" HorizontalAlignment="Right" FontSize="10" Margin="0,3,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource SecondaryText}" FontFamily="Consolas" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,8" MaxHeight="42" />
                            <WrapPanel>
                                <Button Content="Open" Click="OpenSelected_Click" Margin="0,0,5,5" />
                                <Button Content="Explorer" Click="RevealSelected_Click" Margin="0,0,5,5" />
                                <Button Content="Copy path" Click="CopyPath_Click" Margin="0,0,5,5" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#0E141B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SecondaryText}" FontSize="10" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ProductIdentity}" Foreground="#607080" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
